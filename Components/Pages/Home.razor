                    <span class="key">Bellek (RAM)</span>
                    <span class="val">@TotalRamGb GB</span>
                </div>
                <div class="row">
                    <span class="key">Depolama</span>
                    <span class="val">@TotalStorageGb GB</span>
                </div>
            </div>

            <section class="verdict">
                <div class="verdict-header">
                    <strong style="color: #ffffff; font-family: 'Montserrat', sans-serif; font-size: 15px;">Genel Yargu Hükmü</strong>
                    <span class="score-badge">@Score / 100</span>
                </div>
                <p style="color: #e2e8f0; font-size: 13px; line-height: 1.5; margin-bottom: 12px;">@Verdict</p>
                <textarea class="report-box" readonly>@Report</textarea>
                <button class="btn-gradient" style="margin-top: 10px;" @onclick="CopyReport">
                    <span>📋</span> Raporu Kopyala
