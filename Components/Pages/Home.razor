    private async Task RunCpuTest()
    {
        if (IsTestingCpu) return;
        IsTestingCpu = true;
        StateHasChanged();
        await Task.Delay(100);

        var sw = System.Diagnostics.Stopwatch.StartNew();
        long operations = 0;
        int cores = Environment.ProcessorCount;
        var tasks = new Task[cores];
        using var cts = new CancellationTokenSource(1200);

        for (int c = 0; c < cores; c++)
        {
            tasks[c] = Task.Run(() =>
            {
                long localOps = 0;
                double dummy = 1.0;
                while (!cts.Token.IsCancellationRequested)
                {
                    dummy = Math.Sin(dummy) * Math.Cos(dummy) + Math.Sqrt(dummy + 1.0);
                    localOps += 10;
                }
                Interlocked.Add(ref operations, localOps);
            });
        }

        await Task.WhenAll(tasks);
        sw.Stop();
        CpuScore = Math.Clamp((int)(operations / 12000), 1000, 99999);
        CpuTestPassed = true;
        IsTestingCpu = false;
        StateHasChanged();
    }

    private void StartAccelerometer()
    {
        try
        {
            if (Accelerometer.Default.IsSupported && !AccelStarted)
            {
                Accelerometer.Default.ReadingChanged += OnAccelerometerReadingChanged;
                Accelerometer.Default.Start(SensorSpeed.UI);
                AccelStarted = true;
            }
        }
        catch { }
    }

    private void OnAccelerometerReadingChanged(object? sender, AccelerometerChangedEventArgs e)
    {
        AccelX = Math.Round(e.Reading.Acceleration.X, 2);
        AccelY = Math.Round(e.Reading.Acceleration.Y, 2);
        AccelZ = Math.Round(e.Reading.Acceleration.Z, 2);
        InvokeAsync(StateHasChanged);
    }

    private void LoadNetworkInfo()
    {
        try
        {
            HasInternet = Connectivity.Current.NetworkAccess == NetworkAccess.Internet;
            var profile = Connectivity.Current.ConnectionProfiles.FirstOrDefault();
            NetworkType = profile switch
            {
                ConnectionProfile.WiFi => "Wi-Fi (Kablosuz)",
                ConnectionProfile.Cellular => "Mobil Veri (4.5G/5G)",
                ConnectionProfile.Ethernet => "Ethernet",
                _ => "Bağlı Değil"
            };
        }
        catch
        {
            NetworkType = "Wi-Fi Aktif";
            HasInternet = true;
        }
    }

    private void LoadSystemStorageAndRam()
    {
#if ANDROID
        try
        {
            var stat = new Android.OS.StatFs(Android.OS.Environment.DataDirectory?.Path ?? "/data");
            long blockSize = stat.BlockSizeLong;
            TotalStorageGb = Math.Round((stat.BlockCountLong * blockSize) / (1024.0 * 1024 * 1024), 1);
            FreeStorageGb = Math.Round((stat.AvailableBlocksLong * blockSize) / (1024.0 * 1024 * 1024), 1);
            UsedStorageGb = Math.Round(TotalStorageGb - FreeStorageGb, 1);
            StoragePercent = TotalStorageGb > 0 ? (int)Math.Round(UsedStorageGb / TotalStorageGb * 100) : 0;
        }
        catch { }

        try
        {
            var actManager = (Android.App.ActivityManager?)Android.App.Application.Context.GetSystemService(Android.Content.Context.ActivityService);
            var memInfo = new Android.App.ActivityManager.MemoryInfo();
            if (actManager != null)
            {
                actManager.GetMemoryInfo(memInfo);
                TotalRamGb = Math.Round(memInfo.TotalMem / (1024.0 * 1024 * 1024), 1);
                AvailRamGb = Math.Round(memInfo.AvailMem / (1024.0 * 1024 * 1024), 1);
                UsedRamGb = Math.Round(TotalRamGb - AvailRamGb, 1);
                RamPercent = TotalRamGb > 0 ? (int)Math.Round(UsedRamGb / TotalRamGb * 100) : 0;
            }
        }
        catch { }
#else
        TotalStorageGb = 256.0; FreeStorageGb = 168.4; UsedStorageGb = 87.6; StoragePercent = 34;
        TotalRamGb = 8.0; AvailRamGb = 4.2; UsedRamGb = 3.8; RamPercent = 48;
#endif
    }

