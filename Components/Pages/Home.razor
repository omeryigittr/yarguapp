@page "/"
@using System.Globalization
@using System.IO
@using System.Linq
@using System.Threading
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@implements IDisposable
@inject IJSRuntime JS

<style>
    :root {
        --om-bg: #0b0f19;
        --om-card: #1f2937;
        --om-card-border: #374151;
        --om-text-main: #f9fafb;
        --om-text-muted: #9ca3af;
        --om-blue: #3b82f6;
        --om-purple: #8a2be2;
        --om-violet: #7c3aed;
        --om-cyan: #0091f8;
        --om-emerald: #10b981;
        --om-amber: #f59e0b;
        --om-gradient-primary: linear-gradient(90deg, #0091f8 0%, #8a2be2 71%, #d755e9 100%);
        --om-gradient-bar: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
        --om-gradient-gold: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    }

    * { box-sizing: border-box; }

    .app {
        min-height: 100vh;
        padding: max(16px, env(safe-area-inset-top)) 16px calc(92px + env(safe-area-inset-bottom));
        background: var(--om-bg);
        color: var(--om-text-main);
        font-family: 'Raleway', -apple-system, BlinkMacSystemFont, sans-serif;
        display: flex;
        flex-direction: column;
        align-items: center;
        user-select: none;
    }

    .wrap {
        width: 100%;
        max-width: 580px;
    }

    /* HEADER & BRANDING */
    .header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 18px;
    }
    .brand-wrap {
        display: flex;
        flex-direction: column;
    }
    .creator-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 6px;
        padding: 4px 12px;
        border-radius: 50px;
        background: rgba(138, 43, 226, 0.15);
        border: 1px solid rgba(138, 43, 226, 0.4);
        color: #c084fc;
        font-family: 'Montserrat', sans-serif;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.25s ease;
        width: fit-content;
    }
    .creator-badge:active {
        transform: scale(0.97);
        background: rgba(138, 43, 226, 0.3);
    }
    .brand-title {
        font-family: 'Montserrat', sans-serif;
        font-size: 28px;
        line-height: 1.1;
        font-weight: 900;
        letter-spacing: 0.15em;
        margin: 0;
    }
    .gradient-text {
        background: var(--om-gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        display: inline-block;
    }
    .brand-sub {
        color: var(--om-text-muted);
        font-family: 'Montserrat', sans-serif;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.12em;
        margin-top: 3px;
    }
    .badge-pill {
        border-radius: 50px;
        padding: 5px 12px;
        color: #93c5fd;
        background: rgba(37, 99, 235, 0.15);
        border: 1px solid rgba(37, 99, 235, 0.3);
        font-family: 'Montserrat', sans-serif;
        font-size: 10px;
        font-weight: 800;
        white-space: nowrap;
    }

    /* CARDS */
    .card {
        border: 1px solid var(--om-card-border);
        border-radius: 20px;
        background: var(--om-card);
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4), 0 8px 10px -6px rgba(0, 0, 0, 0.4);
        color: var(--om-text-main);
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    /* HERO RING */
    .hero {
        padding: 22px 18px;
        text-align: center;
        background: linear-gradient(180deg, #1f2937 0%, #172030 100%);
    }
    .ring {
        position: relative;
        width: 200px;
        height: 200px;
        margin: auto;
    }
    .ring svg {
        width: 100%;
        height: 100%;
        transform: rotate(-90deg);
    }
    .track { stroke: #374151; fill: none; stroke-width: 12; }
    .progress {
        stroke: #38bdf8;
        fill: none;
        stroke-width: 12;
        stroke-linecap: round;
        transition: stroke-dashoffset 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        filter: drop-shadow(0 0 8px rgba(56, 189, 248, 0.5));
    }
    .ring-text {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
    .percent {
        font-family: 'Montserrat', sans-serif;
        font-size: 44px;
        font-weight: 900;
        color: #ffffff;
        letter-spacing: -0.02em;
    }
    .health {
        color: #38bdf8;
        font-family: 'Montserrat', sans-serif;
        font-size: 13px;
        font-weight: 800;
        margin-top: 2px;
    }
    .capacities {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 18px;
    }
    .capacity {
        padding: 12px 14px;
        border-radius: 14px;
        background: rgba(11, 15, 25, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.06);
    }
    .capacity .muted {
        color: var(--om-text-muted);
        font-family: 'Montserrat', sans-serif;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.05em;
    }
    .capacity .value {
        margin-top: 4px;
        font-family: 'Montserrat', sans-serif;
        font-size: 18px;
        font-weight: 900;
        color: #ffffff;
    }

    /* GRID & METRIC CARDS */
    .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 14px;
    }
    .metric {
        min-height: 120px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .metric .label {
        color: var(--om-text-muted);
        font-family: 'Montserrat', sans-serif;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .metric .value {
        font-family: 'Montserrat', sans-serif;
        font-size: 22px;
        font-weight: 900;
        color: #ffffff;
        margin-top: 4px;
    }
    .metric .value.cyan { color: #38bdf8; }
    .metric .value.purple { color: #c084fc; }
    .metric .value.green { color: #34d399; }
    .metric .small {
        color: #6b7280;
        font-size: 11px;
        line-height: 1.4;
        margin-top: 4px;
    }
    .temp {
        display: inline-block;
        margin-top: 6px;
        padding: 4px 10px;
        border-radius: 50px;
        font-family: 'Montserrat', sans-serif;
        font-size: 10px;
        font-weight: 800;
        color: #34d399;
        background: rgba(16, 185, 129, 0.15);
        border: 1px solid rgba(16, 185, 129, 0.3);
    }
    .temp.warn {
        color: #fbbf24;
        background: rgba(245, 158, 11, 0.15);
        border: 1px solid rgba(245, 158, 11, 0.3);
    }
    .temp.danger {
        color: #f87171;
        background: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.3);
    }

    /* INFO & PHILOSOPHY CARDS */
    .info-card {
        margin-top: 14px;
        padding: 16px;
        border: 1px solid rgba(138, 43, 226, 0.3);
        background: linear-gradient(180deg, rgba(138, 43, 226, 0.08) 0%, #1f2937 100%);
        border-radius: 18px;
    }
    .info-card strong {
        color: #c084fc;
        font-family: 'Montserrat', sans-serif;
        font-size: 13px;
        display: block;
        margin-bottom: 4px;
    }
    .info-card p {
        color: var(--om-text-muted);
        font-size: 12px;
        line-height: 1.5;
        margin: 0;
    }

    /* BUTTONS */
    .btn-gradient {
        width: 100%;
        margin-top: 14px;
        border: 0;
        border-radius: 30px;
        padding: 14px;
        color: #ffffff;
        background: var(--om-gradient-primary);
        font-family: 'Montserrat', sans-serif;
        font-size: 13px;
        font-weight: 800;
        cursor: pointer;
        box-shadow: 0 8px 20px rgba(138, 43, 226, 0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.25s ease;
    }
    .btn-gradient:active {
        transform: scale(0.98);
        box-shadow: 0 4px 10px rgba(138, 43, 226, 0.2);
    }
    .btn-secondary {
        border: 1px solid var(--om-card-border);
        border-radius: 30px;
        background: rgba(17, 24, 39, 0.6);
        color: #ffffff;
        box-shadow: none;
    }

    /* SCREEN TEST SWITCHER */
    .switch {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 6px;
        padding: 6px;
        margin-bottom: 16px;
        border-radius: 16px;
        background: var(--om-card);
        border: 1px solid var(--om-card-border);
    }
    .switch button {
        border: 0;
        border-radius: 12px;
        padding: 10px 4px;
        color: var(--om-text-muted);
        background: transparent;
        font-family: 'Montserrat', sans-serif;
        font-size: 11px;
        font-weight: 800;
        cursor: pointer;
        transition: all 0.25s ease;
    }
    .switch button.active {
        color: #ffffff;
        background: var(--om-gradient-bar);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
    }

    /* TOUCH MATRIX */
    .matrix {
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        gap: 5px;
        padding: 10px;
        border-radius: 16px;
        background: #0b0f19;
        border: 1px solid var(--om-card-border);
        touch-action: none;
        user-select: none;
    }
    .touch-cell {
        aspect-ratio: 1;
        border: 1px solid var(--om-card-border);
        border-radius: 6px;
        background: #172030;
        transition: background 0.08s ease;
    }
    .touch-cell.hit {
        border-color: #38bdf8 !important;
        background: #0284c7 !important;
        box-shadow: 0 0 10px rgba(56, 189, 248, 0.7);
    }

    /* DIAGNOSTICS GRID (Samsung Members style) */
    .diag-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 12px;
    }
    .diag-card {
        padding: 16px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 10px;
    }
    .diag-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .diag-icon { font-size: 22px; }
    .diag-badge {
        font-family: 'Montserrat', sans-serif;
        font-size: 10px;
        font-weight: 800;
        padding: 3px 8px;
        border-radius: 50px;
        background: #111827;
        color: var(--om-text-muted);
        border: 1px solid #374151;
    }
    .diag-badge.active {
        background: rgba(56, 189, 248, 0.15);
        color: #38bdf8;
        border-color: rgba(56, 189, 248, 0.4);
    }
    .diag-title {
        color: #ffffff;
        font-family: 'Montserrat', sans-serif;
        font-size: 13px;
        font-weight: 800;
    }
    .diag-sub {
        color: var(--om-text-muted);
        font-size: 11px;
        line-height: 1.3;
    }
    .diag-btn-row {
        display: flex;
        gap: 6px;
        margin-top: 6px;
    }
    .diag-btn-sm {
        flex: 1;
        border: 0;
        border-radius: 8px;
        padding: 8px 4px;
        font-family: 'Montserrat', sans-serif;
        font-size: 10px;
        font-weight: 800;
        color: #ffffff;
        background: #111827;
        cursor: pointer;
        text-align: center;
        border: 1px solid #374151;
        transition: background 0.15s;
    }
    .diag-btn-sm:active {
        background: var(--om-violet);
    }
    .meter-bar {
        width: 100%;
        height: 6px;
        background: #111827;
        border-radius: 3px;
        overflow: hidden;
        margin-top: 6px;
        border: 1px solid #374151;
    }
    .meter-fill {
        height: 100%;
        background: var(--om-gradient-primary);
        border-radius: 3px;
        transition: width 0.3s;
    }
    .level-bubble-wrap {
        width: 100%;
        height: 60px;
        background: #111827;
        border-radius: 12px;
        border: 1px solid #374151;
        position: relative;
        overflow: hidden;
        margin-top: 6px;
    }
    .level-bubble {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: #8a2be2;
        box-shadow: 0 0 12px #8a2be2;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        transition: transform 0.1s ease-out;
    }

    /* DEVICE INFO & VERDICT */
    .device {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .device .row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 13px 16px;
        border-radius: 14px;
        background: var(--om-card);
        border: 1px solid var(--om-card-border);
    }
    .device .key {
        color: var(--om-text-muted);
        font-family: 'Montserrat', sans-serif;
        font-size: 12px;
        font-weight: 700;
    }
    .device .val {
        color: #ffffff;
        font-family: 'Montserrat', sans-serif;
        font-size: 12px;
        font-weight: 800;
        text-align: right;
    }
    .verdict {
        margin-top: 16px;
        padding: 20px;
        border: 1px solid rgba(138, 43, 226, 0.4);
        background: linear-gradient(145deg, rgba(138, 43, 226, 0.12) 0%, #1f2937 100%);
        border-radius: 20px;
    }
    .verdict-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
    }
    .score-badge {
        font-family: 'Montserrat', sans-serif;
        color: #ffffff;
        font-size: 24px;
        font-weight: 900;
        background: var(--om-gradient-primary);
        padding: 4px 14px;
        border-radius: 12px;
        box-shadow: 0 4px 12px rgba(138, 43, 226, 0.4);
    }
    .report-box {
        width: 100%;
        min-height: 120px;
        padding: 12px;
        border: 1px solid var(--om-card-border);
        border-radius: 12px;
        color: var(--om-text-muted);
        background: #111827;
        font-family: monospace;
        font-size: 11px;
        resize: none;
        user-select: text;
        line-height: 1.4;
    }

    /* PHILOSOPHY & ABOUT */
    .yargu-philosophy-card {
        margin-top: 16px;
        padding: 20px;
        border: 1px solid rgba(37, 99, 235, 0.35);
        background: linear-gradient(180deg, rgba(37, 99, 235, 0.1) 0%, #1f2937 100%);
        border-radius: 20px;
    }
    .old-turkic {
        color: #38bdf8;
        font-family: 'Montserrat', sans-serif;
        font-size: 14px;
        font-weight: 800;
        letter-spacing: 0.1em;
        margin-bottom: 8px;
    }
    .yargu-philosophy-card p {
        color: #d1d5db;
        font-size: 13px;
        line-height: 1.6;
        margin-bottom: 12px;
    }
    .author-highlight {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 12px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
    .author-text {
        color: var(--om-text-muted);
        font-size: 12px;
    }
    .author-text strong {
        color: #38bdf8;
    }
    .link-btn {
        background: transparent;
        border: 0;
        color: #c084fc;
        font-family: 'Montserrat', sans-serif;
        font-weight: 800;
        font-size: 12px;
        cursor: pointer;
        padding: 0;
    }

    /* FLOATING HIRE BAR (omeryigit.tr signature bar) */
    .floating-hire-bar {
        width: 100%;
        margin-top: 18px;
        margin-bottom: 6px;
        background: var(--om-gradient-bar);
        color: #ffffff;
        padding: 12px 20px;
        border-radius: 50px;
        box-shadow: 0 10px 20px rgba(37, 99, 235, 0.35);
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        border: 1px solid rgba(255,255,255,0.25);
        transition: transform 0.2s ease;
    }
    .floating-hire-bar:active {
        transform: scale(0.98);
    }

    /* BOTTOM NAVIGATION BAR */
    .bottom-nav {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 100;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        max-width: 580px;
        margin: auto;
        padding: 8px 10px calc(8px + env(safe-area-inset-bottom, 8px));
        border-top: 1px solid var(--om-card-border);
        background: rgba(17, 24, 39, 0.95);
        backdrop-filter: blur(16px);
    }
    .bottom-nav button {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 3px;
        border: 0;
        background: transparent;
        color: #6b7280;
        font-family: 'Montserrat', sans-serif;
        font-size: 10px;
        font-weight: 800;
        padding: 6px 0;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .bottom-nav button.active {
        color: #ffffff;
        background: var(--om-gradient-bar);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
    }
    .bottom-nav button span.icon { font-size: 16px; }

    /* OVERLAYS */
    .touch-overlay {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: flex;
        flex-direction: column;
        background: var(--om-bg);
        padding: max(16px, env(safe-area-inset-top)) 10px max(16px, env(safe-area-inset-bottom));
        touch-action: none;
    }
    .touch-overlay-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 14px;
        margin-bottom: 10px;
        background: var(--om-card);
        border-radius: 14px;
        border: 1px solid var(--om-card-border);
    }
    .touch-overlay-head strong {
        color: #ffffff;
        font-family: 'Montserrat', sans-serif;
        font-size: 14px;
    }
    .touch-overlay-head .counter {
        color: #38bdf8;
        font-family: 'Montserrat', sans-serif;
        font-weight: 800;
        font-size: 13px;
    }
    .touch-overlay-head .btn-close {
        border: 0;
        border-radius: 8px;
        padding: 6px 12px;
        background: #ef4444;
        color: #ffffff;
        font-family: 'Montserrat', sans-serif;
        font-weight: 800;
        font-size: 11px;
        cursor: pointer;
    }
    .touch-overlay .matrix {
        flex: 1;
        grid-template-columns: repeat(8, 1fr);
        grid-template-rows: repeat(12, 1fr);
        gap: 4px;
        padding: 6px;
        min-height: 0;
    }
    .touch-overlay .touch-cell {
        aspect-ratio: auto;
        min-height: 0;
    }
    .scan-overlay {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        padding: 24px;
        text-align: center;
    }
    .scan-overlay strong {
        font-family: 'Montserrat', sans-serif;
        font-size: 22px;
        font-weight: 900;
        text-shadow: 0 2px 10px rgba(0,0,0,0.8);
    }
</style>

<div class="app">
    <div class="wrap">
        @if (Tab == 0)
        {
            <!-- PIL DİVANI -->
            <header class="header">
                <div class="brand-wrap">
                    <div class="creator-badge" @onclick="OpenWebsite">
                        <span>⚡</span>
                        <span>Ömer YİĞİT • omeryigit.tr ↗</span>
                    </div>
                    <h1 class="brand-title"><span class="gradient-text">YARGU</span></h1>
                    <div class="brand-sub">DONANIM &amp; PİL HÜKÜM DİVANI</div>
                </div>
                <span class="badge-pill">@DataSource</span>
            </header>

            <section class="card hero">
                <div class="ring">
                    <svg viewBox="0 0 220 220">
                        <circle class="track" cx="110" cy="110" r="88" />
                        <circle class="progress" cx="110" cy="110" r="88"
                                stroke-dasharray="@Circumference.ToString("F2", CultureInfo.InvariantCulture)"
                                stroke-dashoffset="@DashOffset.ToString("F2", CultureInfo.InvariantCulture)" />
                    </svg>
                    <div class="ring-text">
                        <div class="percent">%@HealthPercentage</div>
                        <div class="health">@HealthStatus</div>
                    </div>
                </div>

                <div class="capacities">
                    <div class="capacity">
                        <div class="muted">FABRİKA KAPASİTESİ</div>
                        <div class="value">@DesignCapacityMah mAh</div>
                    </div>
                    <div class="capacity">
                        <div class="muted">ÖLÇÜLEN KAPASİTE</div>
                        <div class="value" style="color: #38bdf8;">@CurrentFullCapacityMah mAh</div>
                    </div>
                </div>
            </section>

            <section class="info-card">
                <strong>🔬 Evrensel BMS Donanım Ölçümü (@Manufacturer.ToUpperInvariant())</strong>
                <p>
                    Donanım yakıt sayacından (Coulomb Counter) çekilen anlık yük: <strong>@CurrentFullCapacityMah mAh</strong>. 
                    Fabrika tasarım değeri (@DesignCapacityMah mAh) baz alınarak <strong>%@HealthPercentage</strong> gerçek pil sağlığı hesaplandı.
                    <br /><br />
                    <em>⚡ Sıfır RAM:</em> Arka planda servis çalışmaz; Android çekirdeğinin yakıt çipi doğrudan sorgulanır (0 MB RAM, %0 pil sarfiyatı).
                </p>
            </section>

            <div class="grid">
                <section class="card metric">
                    <div class="label">Canlı Güç</div>
                    <div class="value @(Charging ? "cyan" : "purple")">
