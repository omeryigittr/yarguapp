    }

#if ANDROID
    private static Android.Hardware.Camera2.CameraManager? _cameraManager;
    private static string? _torchCameraId;

    private static void SetFlashlightAndroidNative(bool enabled)
    {
        try
        {
            var ctx = Android.App.Application.Context;
            _cameraManager ??= (Android.Hardware.Camera2.CameraManager?)ctx.GetSystemService(Android.Content.Context.CameraService);
            if (_cameraManager != null)
            {
                if (_torchCameraId == null)
                {
                    foreach (var id in _cameraManager.GetCameraIdList())
                    {
                        var chars = _cameraManager.GetCameraCharacteristics(id);
                        var hasFlash = (Java.Lang.Boolean?)chars.Get(Android.Hardware.Camera2.CameraCharacteristics.FlashInfoAvailable);
                        var facing = (Java.Lang.Integer?)chars.Get(Android.Hardware.Camera2.CameraCharacteristics.LensFacing);
                        if (hasFlash?.BooleanValue() == true && facing?.IntValue() == (int)Android.Hardware.Camera2.LensFacing.Back)
                        {
                            _torchCameraId = id;
                            break;
                        }
                    }
                    _torchCameraId ??= _cameraManager.GetCameraIdList().FirstOrDefault();
                }

                if (_torchCameraId != null)
                {
                    _cameraManager.SetTorchMode(_torchCameraId, enabled);
                }
            }
        }
        catch { }
    }
#endif

