@if (TouchTestActive)
{
    <div class="touch-overlay">
        <div class="touch-overlay-head">
            <div>
                <strong>Tam Ekran Dokunmatik Testi</strong>
                <div class="counter">@TouchedCount / 96 (%@TouchedPercentage)</div>
            </div>
            <div style="display: flex; gap: 8px;">
                <button class="diag-btn-sm" style="flex: unset; padding: 6px 12px;" @onclick="ResetMatrix">Sıfırla</button>
                <button class="btn-close" @onclick="StopTouchTest">Kapat</button>
            </div>
        </div>

        <div id="fullscreen-touch-grid" class="matrix">
            @for (var i = 0; i < Matrix.Length; i++)
            {
                var cell = i;
                <div class="touch-cell @(Matrix[cell] ? "hit" : "")" data-index="@cell"></div>
            }
        </div>
    </div>
}
else if (ScanActive)
{
    <div class="scan-overlay" style="background: @PatternColor; color: @(PatternColor == "#ffffff" ? "#000" : "#fff");" @onclick="NextScan">
        <strong>@PatternLabel</strong>
        <small style="margin-top: 8px; font-size: 12px; opacity: 0.85;">Dokunarak sonraki renge geçin (@(ScanStep + 1)/@PatternColors.Length)</small>
    </div>
}

@code {
    private readonly bool[] Matrix = new bool[96];
    private readonly string[] RgbColors = { "#ff0000", "#00ff00", "#0000ff", "#ffffff", "#000000" };
    private readonly string[] RgbNames = { "SAF KIRMIZI", "SAF YEŞİL", "SAF MAVİ", "SAF BEYAZ", "SAF SİYAH" };
    private readonly string[] GrayColors = { "#000000", "#202020", "#404040", "#606060", "#808080", "#a0a0a0", "#c0c0c0", "#ffffff" };
    private readonly string[] GrayNames = { "SİYAH", "GRİ %12", "GRİ %25", "GRİ %37", "GRİ %50", "GRİ %62", "GRİ %75", "BEYAZ" };
    private readonly string[] BarColors = { "#ff0000", "#00ff00", "#0000ff", "#ffffff", "#00ffff", "#ff00ff", "#ffff00", "#000000" };
    private readonly string[] BarNames = { "KIRMIZI", "YEŞİL", "MAVİ", "BEYAZ", "CAMGÖBEĞİ", "MACENTA", "SARI", "SİYAH" };

    private Timer? timer;
    private DotNetObjectReference<Home>? dotNetHelper;
    private int Tab = 0;
    private int ScreenMode = 0;
    private int CycleCount = -1;
    private int DesignCapacityMah = 4500;
    private int CurrentFullCapacityMah = 4195;
    private int HealthPercentage = 97;
    private int LevelPercentage = 100;
    private int VoltageMv = 4080;
    private int CurrentMa = 25;
    private int SdkInt = 0;
    private int ScanStep;
    private int ProcessorCount = Environment.ProcessorCount;
    private double TemperatureCelsius = 27;
    private double PowerWatts;
    private bool Charging;
    private bool ScreenTestPassed;
    private bool ScanActive;
    private bool TouchTestActive;
    private bool ReportCopied;

    /* Donanım Tanı Alanları */
    private bool VibrationTested;
    private bool FlashlightOn;
    private bool AudioTested;
    private bool CpuTestPassed;
    private bool IsTestingCpu;
    private int CpuScore;
    private double TotalStorageGb;
    private double FreeStorageGb;
    private double UsedStorageGb;
    private int StoragePercent;
    private double TotalRamGb;
    private double AvailRamGb;
    private double UsedRamGb;
    private int RamPercent;
    private string NetworkType = "Wi-Fi";
    private bool HasInternet = true;
    private double AccelX, AccelY, AccelZ;
    private bool AccelStarted;

    private string Manufacturer = "Android";
    private string Model = "Cihaz";
    private string Hardware = "SoC";
    private string Board = "Board";
    private string AndroidRelease = "14";
    private string BatteryTechnology = "Li-ion";
    private string DataSource = "BMS DONANIM VERİSİ";

    private int TouchedCount => Matrix.Count(x => x);
    private int TouchedPercentage => (int)Math.Round(TouchedCount / 96d * 100);
    private double Circumference => 2 * Math.PI * 88;
    private double DashOffset => Circumference * (1 - Math.Clamp(HealthPercentage, 0, 100) / 100d);
    private string HealthStatus => HealthPercentage >= 95 ? "Çok İyi (Normal Yıpranma)" : HealthPercentage >= 85 ? "Normal Durum" : "Servis Önerilir";
    private string TemperatureStatus => TemperatureCelsius >= 45 ? "Kritik Sıcaklık" : TemperatureCelsius >= 38 ? "Yüksek Sıcaklık" : "Normal";
    private string TemperatureClass => TemperatureCelsius >= 45 ? "danger" : TemperatureCelsius >= 38 ? "warn" : "";
    private int Score => Math.Clamp((int)Math.Round(HealthPercentage * 0.45 + (TemperatureCelsius <= 40 ? 20 : 10) + (ScreenTestPassed ? 15 : 0) + (CpuTestPassed ? 10 : 5) + (VibrationTested ? 5 : 0) + (AudioTested ? 5 : 0)), 0, 100);
    private string Verdict => Score >= 85 ? "Cihazınız Yargu Hüküm Divanı'ndan tam geçer not alarak onaylandı." : Score >= 65 ? "Cihaz kullanılabilir durumda; ancak bazı donanım takipleri önerilir." : "Donanım veya batarya servisi önerilir.";
    private string Report => $"=== YARGU APP DONANIM HÜKMÜ ===\nGeliştirici: Ömer Yiğit (omeryigit.tr)\n\nCihaz: {Manufacturer} {Model}\nİşlemci: {Hardware} ({ProcessorCount} Çekirdek)\nBellek (RAM): {UsedRamGb}/{TotalRamGb} GB\nDepolama: {UsedStorageGb}/{TotalStorageGb} GB (Boş: {FreeStorageGb} GB)\nPil Sağlığı: %{HealthPercentage} ({HealthStatus})\nÖlçülen Pil: {CurrentFullCapacityMah} mAh / {DesignCapacityMah} mAh\nSıcaklık: {TemperatureCelsius:F1} °C\nEkran Testi: {(ScreenTestPassed ? "Tamamlandı" : "Kısmi")}\nCPU Yargu Skoru: {(CpuScore > 0 ? CpuScore.ToString() : "Test Edilmedi")}\n\nGENEL YARGU PUANI: {Score}/100\nHüküm: {Verdict}\nDoğrulama: omeryigit.tr/yargu";

    private string[] PatternColors => ScreenMode == 2 ? GrayColors : ScreenMode == 3 ? BarColors : RgbColors;
    private string[] PatternNames => ScreenMode == 2 ? GrayNames : ScreenMode == 3 ? BarNames : RgbNames;
    private string PatternColor => PatternColors[Math.Clamp(ScanStep, 0, PatternColors.Length - 1)];
    private string PatternLabel => PatternNames[Math.Clamp(ScanStep, 0, PatternNames.Length - 1)];
    private string PatternTitle => ScreenMode == 2 ? "Gri Ton ve Parlaklık Testi" : ScreenMode == 3 ? "Renk Şeritleri Testi" : "RGB Ölü Piksel Tarayıcısı";
    private string PatternDescription => ScreenMode == 2 ? "Siyah ile beyaz arasındaki ton geçişlerini ve panel homojenliğini kontrol edin." : ScreenMode == 3 ? "Paneldeki temel ve ara renklerin doğruluğunu tam ekranda inceleyin." : "Ekranı saf renklerle kaplayarak ölü veya takılı pikselleri kontrol edin.";

    protected override void OnInitialized()
    {
        dotNetHelper = DotNetObjectReference.Create(this);
        LoadBatteryData();
        LoadSystemStorageAndRam();
        LoadNetworkInfo();
        StartAccelerometer();

        timer = new Timer(async _ =>
        {
            LoadBatteryData();
            LoadNetworkInfo();
            await InvokeAsync(StateHasChanged);
        }, null, 2000, 2000);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (TouchTestActive)
        {
            var initialIndices = Matrix.Select((hit, idx) => hit ? idx : -1).Where(i => i >= 0).ToArray();
            await JS.InvokeVoidAsync("touchTest.init", "fullscreen-touch-grid", dotNetHelper, initialIndices);
        }
        else if (Tab == 1 && ScreenMode == 0)
        {
            var initialIndices = Matrix.Select((hit, idx) => hit ? idx : -1).Where(i => i >= 0).ToArray();
            await JS.InvokeVoidAsync("touchTest.init", "inline-touch-grid", dotNetHelper, initialIndices);
        }
    }

    [JSInvokable]
    public void OnCellTouched(int index, int totalTouched)
    {
        if ((uint)index < Matrix.Length)
        {
            Matrix[index] = true;
        }
        ScreenTestPassed = Matrix.All(x => x);
        StateHasChanged();
    }

    private async Task ResetMatrix()
    {
        Array.Clear(Matrix);
        ScreenTestPassed = false;
        var containerId = TouchTestActive ? "fullscreen-touch-grid" : "inline-touch-grid";
        await JS.InvokeVoidAsync("touchTest.reset", containerId);
        StateHasChanged();
    }

    private void StartTouchTest() => TouchTestActive = true;
    private void StopTouchTest() => TouchTestActive = false;

    private void StartScan()
    {
        ScanStep = 0;
        ScanActive = true;
    }

    private void NextScan()
    {
        if (ScanStep >= PatternColors.Length - 1)
            ScanActive = false;
        else
            ScanStep++;
    }

    /* Donanım Test Fonksiyonları */
    private void TestVibrate(int mode)
    {
        try
        {
            if (Vibration.Default.IsSupported)
            {
                if (mode == 0)
                    Vibration.Default.Vibrate(TimeSpan.FromMilliseconds(150));
                else if (mode == 1)
                {
                    Vibration.Default.Vibrate(TimeSpan.FromMilliseconds(100));
                    Task.Delay(180).ContinueWith(_ => Vibration.Default.Vibrate(TimeSpan.FromMilliseconds(200)));
                }
                else
                    Vibration.Default.Vibrate(TimeSpan.FromMilliseconds(500));
                VibrationTested = true;
            }
        }
        catch { }
    }

